{
  "name": "car-rental-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "backend",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace=@rental/web",
    "dev": "npm run dev --workspace=@rental/web",
    "dev:api": "npm run dev --workspace=@rental/backend",
    "dev:web": "npm run dev --workspace=@rental/web",
    "migrate": "npm run migrate --workspace=@rental/backend",
    "seed": "npm run seed --workspace=@rental/backend",
    "create-owner": "npm run create-owner --workspace=@rental/backend --"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9"
  }
}
