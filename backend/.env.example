# Local development defaults. Copy to .env and adjust.
# In a deployed environment DATABASE_URL and JWT_SECRET are required — the API
# refuses to start without them rather than falling back to localhost.

PORT=4000

# Any Postgres 14+. TLS is turned on automatically for anything that isn't
# localhost, so a hosted connection string works exactly as pasted.
#
# Local:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rentaldb
#
# Hosted — prefer the *pooled* connection string where the provider offers one,
# because serverless functions open many short-lived connections:
#   Neon      postgresql://<user>:<password>@ep-xxx-pooler.<region>.aws.neon.tech/<db>
#   Render    postgresql://<user>:<password>@<host>.<region>-postgres.render.com/<db>
#   Supabase  postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
UPLOADS_DIR=uploads

# Lock this down to the dashboard origins once they're deployed, e.g.
# CORS_ORIGIN=https://car-rental-admin.vercel.app
CORS_ORIGIN=*
